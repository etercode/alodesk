{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "alo-site",
  "description": "What alo.devl0pr.com may ask of the desktop app. No other site (feelm.org, links) gets any of it.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://alo.devl0pr.com/*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "notification:default",
    "allow-set-ptt-key"
  ]
}
